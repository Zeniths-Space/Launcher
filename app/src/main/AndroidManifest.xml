<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        LauncherApps lists and starts apps without QUERY_ALL_PACKAGES or INTERNET. Both
        permissions are granted at install: one lets swipe down open the notification panel, the
        other lets an app's menu ask Android to uninstall it (Android still asks the user to
        confirm). The gestures accessibility service below is off unless the user turns it on.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Package visibility (Android 11+): see exactly the apps that have a launcher icon, no more. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The default Phone, Messages, Browser and Camera apps, to fill the dock the first time. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Apps that offer widgets, for the widget picker. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Fingerprint, face or screen lock before showing hidden apps. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <!--
            The home screen. HOME + DEFAULT makes it a candidate for Android's home app; LAUNCHER
            also lists it in the current launcher, so it can be tried before being made the default.
            singleTask + stateNotNeeded + clearTaskOnLaunch: one instance, always fresh on home.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Zenith gestures: lets home screen gestures open the notification panel or lock the
            screen. Off until the user turns it on in accessibility settings; only the system can
            bind it (BIND_ACCESSIBILITY_SERVICE).
        -->
        <service
            android:name=".GestureService"
            android:exported="true"
            android:label="@string/gesture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_service" />
        </service>

        <!-- Opened from the home screen's long-press menu and the drawer; not reachable by other apps. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Settings" />

        <!-- Places a picked photo as the wallpaper; opened from the wallpaper setting only. -->
        <activity
            android:name=".WallpaperActivity"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Settings" />
    </application>
</manifest>
