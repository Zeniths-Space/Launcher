<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions. LauncherApps lists and starts apps without QUERY_ALL_PACKAGES or INTERNET.
        The gestures accessibility service below is off unless the user turns it on.
    -->

    <!-- Package visibility (Android 11+): see exactly the apps that have a launcher icon, no more. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <!--
            The home screen. HOME + DEFAULT makes it a candidate for Android's home app; LAUNCHER
            also lists it in the current launcher, so it can be tried before being made the default.
            singleTask + stateNotNeeded + clearTaskOnLaunch: one instance, always fresh on home.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Zenith gestures: lets home screen gestures open the notification panel or lock the
            screen. Off until the user turns it on in accessibility settings; only the system can
            bind it (BIND_ACCESSIBILITY_SERVICE).
        -->
        <service
            android:name=".GestureService"
            android:exported="true"
            android:label="@string/gesture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_service" />
        </service>

        <!-- Opened from the home screen's long-press menu and the drawer; not reachable by other apps. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Settings" />
    </application>
</manifest>
