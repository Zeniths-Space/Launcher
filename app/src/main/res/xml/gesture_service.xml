<?xml version="1.0" encoding="utf-8"?>
<!--
    Zenith gestures: global actions only (notification panel, quick settings, lock screen).
    No event types, no window content, no gestures of its own: it sees nothing on screen.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/gesture_service_description"
    android:isAccessibilityTool="false"
    tools:targetApi="31"
    android:notificationTimeout="0"
    android:summary="@string/gesture_service_summary" />
